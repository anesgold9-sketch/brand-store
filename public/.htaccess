<IfModule mod_rewrite.c>
    Options -Indexes
    RewriteEngine On
    
    # السماح بالوصول المباشر للملفات الفعلية (مثل الصور، CSS، JS)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    
    # توجيه باقي الطلبات إلى index.php
    RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
</IfModule>